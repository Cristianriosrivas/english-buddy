# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# IA (solo servidor). Se usa el primer proveedor de AI_PROVIDER que tenga clave;
# si falla (límite, saturación, error), pasa al siguiente. Para usar Groq primero:
# AI_PROVIDER=groq,gemini
# Gemini: https://aistudio.google.com/apikey  ·  Groq: https://console.groq.com/keys
AI_PROVIDER=gemini,groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Mensajes de chat por usuaria al día (UTC)
DAILY_MESSAGE_LIMIT=30
